CC_COMPLIANCE_STATUS = 

VAR _req_id = 'combined_training'[REQ_ID]
VAR _net_id = 'combined_training'[NET_ID]

--
VAR _is_latest_training =
    'combined_training'[EXPIRATION_DATE] =
        CALCULATE(
            MAX('combined_training'[EXPIRATION_DATE]),
            FILTER(
                'combined_training',
                'combined_training'[REQ_ID] = _req_id &&
                'combined_training'[NET_ID] = _net_id
            )
        )

-- Expiration dates
VAR _rcr_expiration =
    CALCULATE(
        MAX('combined_training'[EXPIRATION_DATE]),
        'combined_training'[REQ_ID] = "2",
        'combined_training'[NET_ID] = _net_id
    )

VAR _rcr_f2f_expiration =
    CALCULATE(
        MAX('combined_training'[EXPIRATION_DATE]),
        'combined_training'[REQ_ID] = "1",
        'combined_training'[NET_ID] = _net_id
    )

VAR _coi_expiration =
    CALCULATE(
        MAX('combined_training'[EXPIRATION_DATE]),
        'combined_training'[REQ_ID] = "10",
        'combined_training'[NET_ID] = _net_id
    )

VAR _hsr_expiration =
    CALCULATE(
        MAX('combined_training'[EXPIRATION_DATE]),
        'combined_training'[REQ_ID] = "5",
        'combined_training'[NET_ID] = _net_id
    )

VAR _rst_expiration = 
    CALCULATE(
        MAX('combined_training'[EXPIRATION_DATE]),
        'combined_training'[REQ_ID] = "16",
        'combined_training'[NET_ID] = _net_id
    )

// Other Info
VAR _latest_payroll = 
    CALCULATE(
        MAX('rcr_requirement_tracking'[PAY_END_DATE]),
        combined_training[NET_ID] = _net_id
    )

// Single lookup row from directory
VAR _directory_row =
    CALCULATETABLE(
        'directory',
        'directory'[NETID] = _net_id
    )

VAR _rcr_required =
    MAXX(_directory_row, 'directory'[RCR_ONLINE_REQUIRED]) = "True"

VAR _rcr_f2f_required =
    MAXX(_directory_row, 'directory'[RCR_F2F_REQUIRED]) = "True"

VAR _coi_required =
    MAXX(_directory_row, 'directory'[COI_REQUIRED]) = "True"

VAR _rst_required = 
    MAXX(_directory_row, 'directory'[RST_REQUIRED]) = "True"

VAR _hsr_required = 
    MAXX(_directory_row, 'directory'[HSR_REQUIRED]) = "True"

// Flag for NSF RCR scenario (REQ_ID = "2" and AWARD_TYPE = "NSF")
VAR _rcr_nsf_scenario =
    CALCULATE(
        COUNTROWS('rcr_requirement_tracking'),
        'rcr_requirement_tracking'[NET_ID] = _net_id,
        'rcr_requirement_tracking'[AWARD_TYPE] IN {"NSF", "NIFA"}
    ) > 0

// Compliance Logic
RETURN

    SWITCH(
        TRUE(),

        // Special Case: RCR Online required and award is NSF or NIFA — Always Complete if completed
        // Updated to include all RCR Online, keeping original in case of reversion. _req_id = "2" && _rcr_nsf_scenario,
        _req_id = "2",
            IF(
                _rcr_required,
                IF(
                    NOT ISBLANK(_rcr_expiration) || (NOT ISBLANK(_rcr_f2f_expiration) && (_rcr_f2f_expiration >= TODAY())), 
                    "Complete", 
                    "Not Complete"
                ),
                "Not Applicable"
            ),

        //_req_id = "2",
        //    IF(
        //        _rcr_required,
        //        IF(
        //            NOT ISBLANK(_rcr_expiration) && (_rcr_expiration >= TODAY() || _latest_payroll < _rcr_expiration), 
        //            "Complete",
        //            "Not Complete"
        //        ),
        //        "Not Applicable"
        //    ),

        _req_id = "1",
            IF(
                _rcr_f2f_required,
                IF(
                    NOT ISBLANK(_rcr_f2f_expiration) && (_rcr_f2f_expiration >= TODAY() || _latest_payroll < _rcr_f2f_expiration), 
                    "Complete", 
                    "Not Complete"
                ),
                "Not Applicable"
            ),

        _req_id = "5",
            IF(
                _hsr_required,
                IF(
                    NOT ISBLANK(_hsr_expiration) && _hsr_expiration >= TODAY(), 
                    "Complete", 
                    "Not Complete"
                ),
                "Not Applicable"
            ),

        _req_id = "10",
            IF(
                _coi_required,
                IF(
                    NOT ISBLANK(_coi_expiration) && _coi_expiration >= TODAY(), 
                    "Complete", 
                    "Not Complete"
                ),
                "Not Applicable"
            ),
        
        _req_id = "16",
            IF(
                _rst_required,
                IF(
                    NOT ISBLANK(_rst_expiration) && _rst_expiration >= TODAY(), 
                    "Complete", 
                    "Not Complete"
                ),
                "Not Applicable"
            ),
        BLANK()
    )